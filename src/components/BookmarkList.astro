<div class="list-panel">
  <div class="list-heading">
    <div>
      <p class="step">03 / Your shortlist</p>
      <h2>Saved bookmarks</h2>
    </div>
    <span id="bookmark-count" class="count">0 links</span>
  </div>

  <div id="empty-state" class="empty-state">
    <span aria-hidden="true">↳</span>
    <p id="empty-state-message">Your saved links will appear here.</p>
  </div>
  <ul id="bookmark-list" aria-live="polite"></ul>
</div>

<template id="bookmark-template">
  <li class="bookmark">
    <div class="bookmark-view">
      <div class="bookmark-main">
        <h3 class="bookmark-title"></h3>
        <a class="bookmark-url" target="_blank" rel="noreferrer"></a>
        <ul class="bookmark-tags" aria-label="Tags"></ul>
        <p class="bookmark-notes"></p>
        <div class="slug-row">
          <span class="slash" aria-hidden="true">/</span>
          <code class="bookmark-slug"></code>
        </div>
      </div>
      <div class="bookmark-actions">
        <button class="edit-button" type="button" data-action="edit">Edit</button>
        <button class="remove-button" type="button" data-action="remove">
          Remove
        </button>
      </div>
    </div>

    <form class="bookmark-edit-form" hidden novalidate>
      <div class="edit-field">
        <label>
          <span>Title</span>
          <input name="title" type="text" maxlength="120" required />
        </label>
      </div>
      <div class="edit-field">
        <label>
          <span>Tags</span>
          <input
            name="tags"
            type="text"
            maxlength="240"
            placeholder="work, reference, read later"
          />
        </label>
        <span>Separate up to 8 tags with commas.</span>
      </div>
      <div class="edit-field">
        <label>
          <span>Notes</span>
          <textarea name="notes" maxlength="2000" rows="3"></textarea>
        </label>
      </div>
      <p class="edit-error" role="alert" hidden></p>
      <div class="edit-actions">
        <button type="submit">Save changes</button>
        <button type="button" data-action="cancel">Cancel</button>
      </div>
    </form>
  </li>
</template>
