---
import BookmarkWorkspace from "../components/BookmarkWorkspace.astro";
import Hero from "../components/Hero.astro";
import "../styles/global.css";

const pageTitle = "Shortlist — Local bookmarks";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Save links with short local slugs, right in your browser."
    />
    <meta name="theme-color" content="#244b35" />
    <meta name="color-scheme" content="light" />
    <meta name="application-name" content="Shortlist" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Shortlist" />
    <link rel="icon" href="/icons/shortlist.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/shortlist-apple-touch.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to bookmarks</a>
    <Hero />
    <main id="main-content" tabindex="-1">
      <BookmarkWorkspace />
    </main>

    <script>
      import { initializeBookmarkController } from "../app/bookmark-controller";

      initializeBookmarkController();
    </script>
    <script is:inline src="/registerSW.js"></script>
  </body>
</html>
