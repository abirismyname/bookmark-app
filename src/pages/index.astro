---
import BookmarkWorkspace from "../components/BookmarkWorkspace.astro";
import Hero from "../components/Hero.astro";
import "../styles/global.css";

const pageTitle = "Shortlist — Local bookmarks";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Save links with short local slugs, right in your browser."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔖</text></svg>"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <Hero />
      <BookmarkWorkspace />
    </main>

    <script>
      import { initializeBookmarkController } from "../app/bookmark-controller";

      initializeBookmarkController();
    </script>
  </body>
</html>
