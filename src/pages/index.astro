---
const pageTitle = "Shortlist — Local bookmarks";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Save links with short local slugs, right in your browser."
    />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔖</text></svg>" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <header class="hero">
        <a class="brand" href="/" aria-label="Shortlist home">
          <span class="brand-mark" aria-hidden="true">S</span>
          Shortlist
        </a>
        <div class="intro">
          <p class="eyebrow">Your links, kept close</p>
          <h1>Make the web<br /><em>easy to return to.</em></h1>
          <p class="lede">
            Save any URL and give it a compact, local address. Private by
            default, available whenever you come back.
          </p>
        </div>
      </header>

      <section class="workspace" aria-labelledby="add-heading">
        <div class="form-panel">
          <p class="step">01 / Add a link</p>
          <h2 id="add-heading">What do you want to remember?</h2>
          <form id="bookmark-form" novalidate>
            <label for="bookmark-url">Original URL</label>
            <div class="input-row">
              <input
                id="bookmark-url"
                name="url"
                type="url"
                inputmode="url"
                autocomplete="url"
                placeholder="https://example.com/article"
                required
                aria-describedby="form-message"
              />
              <button type="submit">
                Save link
                <span aria-hidden="true">↗</span>
              </button>
            </div>
            <p id="form-message" class="message" role="status" aria-live="polite">
              Enter a complete http or https URL.
            </p>
          </form>
        </div>

        <div class="list-panel">
          <div class="list-heading">
            <div>
              <p class="step">02 / Your shortlist</p>
              <h2>Saved bookmarks</h2>
            </div>
            <span id="bookmark-count" class="count">0 links</span>
          </div>

          <div id="empty-state" class="empty-state">
            <span aria-hidden="true">↳</span>
            <p>Your saved links will appear here.</p>
          </div>
          <ul id="bookmark-list" aria-live="polite"></ul>
        </div>
      </section>
    </main>

    <template id="bookmark-template">
      <li class="bookmark">
        <div class="bookmark-main">
          <a class="bookmark-url" target="_blank" rel="noreferrer"></a>
          <div class="slug-row">
            <span class="slash" aria-hidden="true">/</span>
            <code class="bookmark-slug"></code>
          </div>
        </div>
        <button class="remove-button" type="button" aria-label="Remove bookmark">
          Remove
        </button>
      </li>
    </template>

    <script>
      interface Bookmark {
        id: string;
        url: string;
        slug: string;
        createdAt: string;
      }

      const STORAGE_KEY = "shortlist.bookmarks.v1";
      const SLUG_LENGTH = 6;
      const SLUG_CHARS =
        "abcdefghjkmnpqrstuvwxyz23456789";

      const form = document.querySelector<HTMLFormElement>("#bookmark-form");
      const input = document.querySelector<HTMLInputElement>("#bookmark-url");
      const message = document.querySelector<HTMLElement>("#form-message");
      const list = document.querySelector<HTMLUListElement>("#bookmark-list");
      const count = document.querySelector<HTMLElement>("#bookmark-count");
      const emptyState = document.querySelector<HTMLElement>("#empty-state");
      const template =
        document.querySelector<HTMLTemplateElement>("#bookmark-template");

      if (!form || !input || !message || !list || !count || !emptyState || !template) {
        throw new Error("Bookmark interface failed to initialize.");
      }

      let bookmarks: Bookmark[] = loadBookmarks();
      render();

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        setMessage("Enter a complete http or https URL.");

        const url = parseUrl(input.value);
        if (!url) {
          setMessage("Please enter a valid http or https URL.", true);
          input.focus();
          return;
        }

        const bookmark: Bookmark = {
          id: crypto.randomUUID(),
          url,
          slug: createUniqueSlug(bookmarks),
          createdAt: new Date().toISOString(),
        };

        bookmarks = [bookmark, ...bookmarks];
        if (!saveBookmarks()) {
          bookmarks = bookmarks.filter((item) => item.id !== bookmark.id);
          return;
        }

        form.reset();
        setMessage(`Saved as /${bookmark.slug}.`);
        render();
        input.focus();
      });

      list.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          ".remove-button",
        );
        const item = button?.closest<HTMLLIElement>("[data-bookmark-id]");
        if (!button || !item) return;

        const previous = bookmarks;
        bookmarks = bookmarks.filter(
          (bookmark) => bookmark.id !== item.dataset.bookmarkId,
        );
        if (!saveBookmarks()) {
          bookmarks = previous;
          return;
        }

        setMessage("Bookmark removed.");
        render();
      });

      function parseUrl(value: string): string | null {
        try {
          const url = new URL(value.trim());
          if (url.protocol !== "http:" && url.protocol !== "https:") return null;
          return url.href;
        } catch {
          return null;
        }
      }

      function createUniqueSlug(existing: Bookmark[]): string {
        const slugs = new Set(existing.map((bookmark) => bookmark.slug));
        let slug = "";

        do {
          const values = crypto.getRandomValues(new Uint32Array(SLUG_LENGTH));
          slug = Array.from(
            values,
            (value) => SLUG_CHARS[value % SLUG_CHARS.length],
          ).join("");
        } while (slugs.has(slug));

        return slug;
      }

      function isBookmark(value: unknown): value is Bookmark {
        if (!value || typeof value !== "object") return false;
        const item = value as Record<string, unknown>;
        return (
          typeof item.id === "string" &&
          typeof item.slug === "string" &&
          typeof item.createdAt === "string" &&
          typeof item.url === "string" &&
          parseUrl(item.url) !== null
        );
      }

      function loadBookmarks(): Bookmark[] {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return [];

        try {
          const value: unknown = JSON.parse(saved);
          if (!Array.isArray(value) || !value.every(isBookmark)) {
            throw new Error("Stored bookmarks have an invalid format.");
          }
          return value;
        } catch (error) {
          const detail =
            error instanceof Error ? error.message : "Unknown storage error.";
          setMessage(`Could not load saved bookmarks: ${detail}`, true);
          return [];
        }
      }

      function saveBookmarks(): boolean {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
          return true;
        } catch {
          setMessage(
            "Could not save bookmarks. Check your browser storage settings.",
            true,
          );
          return false;
        }
      }

      function setMessage(text: string, isError = false): void {
        message.textContent = text;
        message.classList.toggle("error", isError);
      }

      function render(): void {
        list.replaceChildren();

        for (const bookmark of bookmarks) {
          const fragment = template.content.cloneNode(true) as DocumentFragment;
          const item = fragment.querySelector<HTMLLIElement>(".bookmark");
          const url = fragment.querySelector<HTMLAnchorElement>(".bookmark-url");
          const slug = fragment.querySelector<HTMLElement>(".bookmark-slug");
          const remove =
            fragment.querySelector<HTMLButtonElement>(".remove-button");

          if (!item || !url || !slug || !remove) continue;

          item.dataset.bookmarkId = bookmark.id;
          url.href = bookmark.url;
          url.textContent = bookmark.url;
          slug.textContent = bookmark.slug;
          remove.setAttribute("aria-label", `Remove ${bookmark.url}`);
          list.append(fragment);
        }

        const total = bookmarks.length;
        count.textContent = `${total} ${total === 1 ? "link" : "links"}`;
        emptyState.hidden = total > 0;
      }
    </script>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600&family=Playfair+Display:ital,wght@1,600&display=swap");

  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    color-scheme: light;
    font-family: "Manrope", sans-serif;
    color: #17211b;
    background: #f2efe8;
    font-synthesis: none;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background:
      radial-gradient(circle at 87% 8%, rgba(209, 225, 201, 0.7), transparent 28rem),
      #f2efe8;
  }

  :global(button),
  :global(input) {
    font: inherit;
  }

  main {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: 36px 0 72px;
  }

  .hero {
    min-height: 460px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 38px;
    color: #f2efe8;
    background: #244b35;
    border-radius: 2px 2px 12px 12px;
    font-family: "DM Mono", monospace;
    font-size: 14px;
  }

  .intro {
    padding-top: 74px;
  }

  .eyebrow,
  .step {
    margin: 0 0 18px;
    color: #52715f;
    font-family: "DM Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(54px, 7vw, 98px);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.065em;
  }

  h1 em {
    color: #397b52;
    font-family: "Playfair Display", serif;
    font-weight: 600;
  }

  .lede {
    max-width: 580px;
    margin: 34px 0 0;
    color: #566159;
    font-size: 17px;
    line-height: 1.7;
  }

  .workspace {
    overflow: hidden;
    border: 1px solid #c8cbc4;
    background: rgba(250, 249, 245, 0.76);
    box-shadow: 0 24px 80px rgba(31, 50, 38, 0.08);
  }

  .form-panel,
  .list-panel {
    padding: clamp(28px, 5vw, 58px);
  }

  .form-panel {
    background: #244b35;
    color: #f8f4eb;
  }

  .form-panel .step {
    color: #a8c5b1;
  }

  h2 {
    margin: 0;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  form {
    margin-top: 42px;
  }

  label {
    display: block;
    margin-bottom: 10px;
    color: #cad9cd;
    font-size: 13px;
  }

  .input-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
  }

  input {
    min-width: 0;
    padding: 17px 18px;
    border: 1px solid #789080;
    border-radius: 0;
    outline: none;
    color: #f8f4eb;
    background: rgba(255, 255, 255, 0.06);
    transition: border-color 160ms, background 160ms;
  }

  input::placeholder {
    color: #9bb0a1;
  }

  input:focus {
    border-color: #eef0bd;
    background: rgba(255, 255, 255, 0.1);
  }

  button {
    cursor: pointer;
  }

  form button {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 0 20px;
    border: 0;
    color: #17211b;
    background: #e9eea7;
    font-weight: 600;
    transition: background 160ms, transform 160ms;
  }

  form button:hover {
    background: #f4f6cb;
  }

  form button:active {
    transform: translateY(1px);
  }

  .message {
    min-height: 20px;
    margin: 12px 0 0;
    color: #a8c5b1;
    font-size: 12px;
  }

  .message.error {
    color: #ffc9b9;
  }

  .list-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    padding-bottom: 28px;
    border-bottom: 1px solid #cfd1cb;
  }

  .count {
    padding: 7px 11px;
    border: 1px solid #b8beb7;
    color: #637068;
    font-family: "DM Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
  }

  .empty-state {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 150px;
    color: #7b837d;
  }

  .empty-state[hidden] {
    display: none;
  }

  .empty-state span {
    font-size: 26px;
  }

  #bookmark-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bookmark {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 26px 0;
    border-bottom: 1px solid #d7d8d3;
  }

  .bookmark-url {
    display: block;
    overflow: hidden;
    color: #17211b;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bookmark-url:hover {
    color: #397b52;
  }

  .slug-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 9px;
  }

  .slash {
    color: #9aaa9f;
  }

  .bookmark-slug {
    color: #397b52;
    font-family: "DM Mono", monospace;
    font-size: 13px;
  }

  .remove-button {
    padding: 7px 0;
    border: 0;
    border-bottom: 1px solid #9da49f;
    color: #687169;
    background: transparent;
    font-size: 12px;
  }

  .remove-button:hover {
    color: #963c2f;
    border-color: #963c2f;
  }

  @media (max-width: 760px) {
    main {
      width: min(100% - 28px, 620px);
      padding-top: 22px;
    }

    .hero {
      min-height: auto;
      display: block;
      padding-bottom: 64px;
    }

    .intro {
      padding-top: 68px;
    }

    .lede {
      margin-top: 26px;
    }

    .input-row {
      grid-template-columns: 1fr;
    }

    form button {
      justify-content: space-between;
      min-height: 54px;
    }
  }

  @media (max-width: 430px) {
    main {
      width: 100%;
      padding: 20px 14px 40px;
    }

    h1 {
      font-size: 49px;
    }

    .form-panel,
    .list-panel {
      padding: 28px 20px;
    }

    .list-heading {
      align-items: start;
    }

    .bookmark {
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>
